# OcuSphere Optical Retail Environment Configuration
# Ports (Configured to avoid collisions with any other running containers)
PORT=3002
DEV_PORT=5173
BACKEND_PORT=3005
POSTGRES_PORT=5434

# Frontend Configuration
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:3005/api/v1
NODE_ENV=production

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocusphere_optical
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ocusphere_optical?schema=public

# Backend JWT Secret & Security
JWT_SECRET=ocusphere-super-secure-production-jwt-secret-key-2026
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:5173
