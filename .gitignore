# ==============================================================================
# OcuSphere Optical Retail - Root .gitignore
# Full-Stack Monorepo (NestJS Backend + React 19 Vite Frontend + Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# Production & Compiler Build Artifacts
# ------------------------------------------------------------------------------
dist/
*/dist/
build/
*/build/
out/
.next/
.vite/
*/.vite/
.nest/
*/.nest/
*.tsbuildinfo
*/*.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup*
*.backup*
*.bak

# Explicitly keep example environment templates
!.env.example
!deployment/.env.example

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
*.lcov
test-results/

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Database & Local Docker Data
# ------------------------------------------------------------------------------
postgres_data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Operating System & File System Noise
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# VS Code (preserve team workspace configurations if needed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
