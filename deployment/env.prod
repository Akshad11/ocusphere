#!/usr/bin/env bash
# ==============================================================================
# OcuSphere Optical Retail - Production Deployment & Rebuild Script
# ==============================================================================
# Usage:
#   ./deployment/env.prod
#   or: bash deployment/env.prod
#
# Steps performed:
#   1. Resolves workspace root directory
#   2. Executes git pull origin main (or active branch)
#   3. Validates and applies production environment (.env)
#   4. Rebuilds production Docker containers with --no-cache
#   5. Applies production Prisma database migrations
#   6. Prunes unused build artifacts and reports container health
# ==============================================================================

set -eo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}====================================================================${NC}"
echo -e "${CYAN}  OcuSphere Optical Retail — Production Deployment & Rebuild        ${NC}"
echo -e "${CYAN}====================================================================${NC}"

# 1. Determine Project Root Directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${PROJECT_ROOT}"
echo -e "${GREEN}[INFO] Working directory:${NC} ${PROJECT_ROOT}"

# 2. Git Pull Latest Production Code
echo -e "\n${YELLOW}==> [1/7] Fetching latest production commits (git pull)...${NC}"
if [ -d ".git" ]; then
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
    echo -e "    Active branch: ${CYAN}${CURRENT_BRANCH}${NC}"
    if git pull origin "${CURRENT_BRANCH}" 2>/dev/null || git pull; then
        echo -e "    ${GREEN}Repository successfully updated.${NC}"
    else
        echo -e "    ${RED}[WARN] git pull failed or produced conflicts. Please inspect repository state.${NC}"
    fi
else
    echo -e "    ${YELLOW}[INFO] No .git directory detected. Skipping git pull.${NC}"
fi

# 3. Environment Configuration & Security Pre-check
echo -e "\n${YELLOW}==> [2/7] Preparing production environment configuration...${NC}"
PROD_ENV_SOURCE=""
if [ -f "deployment/.env.prod" ]; then
    PROD_ENV_SOURCE="deployment/.env.prod"
elif [ -f "deployment/prod.env" ]; then
    PROD_ENV_SOURCE="deployment/prod.env"
fi

if [ -n "${PROD_ENV_SOURCE}" ]; then
    # Backup current .env if present
    if [ -f ".env" ]; then
        BACKUP_FILE=".env.backup.$(date +%Y%m%d_%H%M%S)"
        cp ".env" "${BACKUP_FILE}"
        echo -e "    Backed up current .env to ${BACKUP_FILE}"
    fi

    cp "${PROD_ENV_SOURCE}" ".env"
    echo -e "    ${GREEN}Applied ${PROD_ENV_SOURCE} -> .env${NC}"

    # Check for placeholder values
    if grep -q "CHANGE_ME" ".env"; then
        echo -e "    ${RED}[SECURITY WARNING] Default placeholder credentials ('CHANGE_ME') detected in .env!${NC}"
        echo -e "    ${YELLOW}Please update POSTGRES_PASSWORD and JWT_SECRET in deployment/.env.prod for production safety.${NC}"
    fi
elif [ -f ".env" ]; then
    echo -e "    ${GREEN}Using existing root .env file.${NC}"
else
    echo -e "    ${RED}[ERROR] Neither deployment/.env.prod nor .env exists.${NC}"
    exit 1
fi

# Export .env variables to current shell session
set -a
# shellcheck disable=SC1091
source .env
set +a

# 4. Pull Base Images & Docker Compose Rebuild
echo -e "\n${YELLOW}==> [3/7] Pulling upstream Docker base images...${NC}"
docker compose pull postgres || true

echo -e "\n${YELLOW}==> [4/7] Stopping running containers and building clean production images...${NC}"
docker compose down --remove-orphans || true

COMPOSE_FILES=("-f" "compose.yaml")
if [ -f "deployment/compose.prod.yaml" ]; then
    COMPOSE_FILES+=("-f" "deployment/compose.prod.yaml")
    echo -e "    Using production compose override: ${CYAN}deployment/compose.prod.yaml${NC}"
fi

echo -e "    Executing: ${CYAN}docker compose ${COMPOSE_FILES[*]} build --no-cache${NC}"
docker compose "${COMPOSE_FILES[@]}" build --no-cache

echo -e "\n${YELLOW}==> [5/7] Starting production containers...${NC}"
docker compose "${COMPOSE_FILES[@]}" up -d --remove-orphans

# 5. Wait for Database Readiness & Apply Prisma Migrations
echo -e "\n${YELLOW}==> [6/7] Verifying database connectivity & applying Prisma migrations...${NC}"
PG_USER="${POSTGRES_USER:-postgres}"
PG_DB="${POSTGRES_DB:-ocusphere_optical}"

MAX_RETRIES=40
COUNT=0
echo -n "    Waiting for PostgreSQL container to become ready"
until docker compose exec -T postgres pg_isready -U "${PG_USER}" -d "${PG_DB}" > /dev/null 2>&1 || [ $COUNT -ge $MAX_RETRIES ]; do
    COUNT=$((COUNT+1))
    echo -n "."
    sleep 1
done
echo ""

if [ $COUNT -ge $MAX_RETRIES ]; then
    echo -e "    ${RED}[ERROR] PostgreSQL timed out after ${MAX_RETRIES} seconds.${NC}"
    exit 1
fi
echo -e "    ${GREEN}PostgreSQL is healthy and accepting connections.${NC}"

echo -e "    Executing production schema migrations..."
docker compose exec -T backend npx prisma migrate deploy

# 6. Cleanup & Status
echo -e "\n${YELLOW}==> [7/7] Pruning dangling Docker build layers...${NC}"
docker image prune -f > /dev/null 2>&1 || true

echo -e "\n${YELLOW}Docker Compose Service Health:${NC}"
docker compose "${COMPOSE_FILES[@]}" ps

PORT_FRONTEND="${PORT:-80}"
PORT_BACKEND="${BACKEND_PORT:-3001}"

echo -e "\n${GREEN}====================================================================${NC}"
echo -e "${GREEN}  Production Deployment Complete! System is LIVE:                   ${NC}"
echo -e "${GREEN}====================================================================${NC}"
echo -e "  * Storefront & POS Ingress: ${CYAN}http://localhost:${PORT_FRONTEND}${NC}"
echo -e "  * Backend API Health:       ${CYAN}http://localhost:${PORT_BACKEND}/api/v1/health${NC}"
echo -e "  * Active Profile:           ${CYAN}production (target: runner)${NC}"
echo -e "${GREEN}====================================================================${NC}"
