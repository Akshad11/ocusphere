#!/usr/bin/env bash
# ==============================================================================
# OcuSphere Optical Retail - Local Deployment & Rebuild Script
# ==============================================================================
# Usage:
#   ./deployment/env.local
#   or: bash deployment/env.local
#
# Steps performed:
#   1. Resolves workspace root directory
#   2. Executes git pull (if repository exists)
#   3. Syncs deployment/.env.local -> .env
#   4. Rebuilds and launches Docker Compose containers
#   5. Runs Prisma ORM client generation & migrations
#   6. Displays active container status & endpoint URLs
# ==============================================================================

set -eo pipefail

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}====================================================================${NC}"
echo -e "${CYAN}  OcuSphere Optical Retail — Local Deployment & Rebuild             ${NC}"
echo -e "${CYAN}====================================================================${NC}"

# 1. Determine Project Root Directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${PROJECT_ROOT}"
echo -e "${GREEN}[INFO] Working directory:${NC} ${PROJECT_ROOT}"

# 2. Git Pull
echo -e "\n${YELLOW}==> [1/6] Pulling latest repository changes...${NC}"
if [ -d ".git" ]; then
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
    echo -e "    Current branch: ${CYAN}${CURRENT_BRANCH}${NC}"
    if git pull; then
        echo -e "    ${GREEN}Git pull successful.${NC}"
    else
        echo -e "    ${YELLOW}[WARN] git pull returned a non-zero exit code. Proceeding with local files...${NC}"
    fi
else
    echo -e "    ${YELLOW}[INFO] No .git directory detected. Skipping git pull.${NC}"
fi

# 3. Environment Configuration
echo -e "\n${YELLOW}==> [2/6] Configuring local environment (.env)...${NC}"
if [ -f "deployment/.env.local" ]; then
    cp "deployment/.env.local" ".env"
    echo -e "    ${GREEN}Copied deployment/.env.local -> .env${NC}"
elif [ -f "deployment/local.env" ]; then
    cp "deployment/local.env" ".env"
    echo -e "    ${GREEN}Copied deployment/local.env -> .env${NC}"
elif [ ! -f ".env" ]; then
    if [ -f ".env.example" ]; then
        cp ".env.example" ".env"
        echo -e "    ${YELLOW}Created .env from .env.example${NC}"
    fi
else
    echo -e "    ${GREEN}Existing .env retained.${NC}"
fi

# Export .env variables to current shell session
if [ -f ".env" ]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
fi

# 4. Docker Compose Down & Rebuild
echo -e "\n${YELLOW}==> [3/6] Stopping old containers & rebuilding Docker images...${NC}"
docker compose down --remove-orphans || true

echo -e "    Running: ${CYAN}docker compose build${NC}"
docker compose build

echo -e "\n${YELLOW}==> [4/6] Starting containers in background...${NC}"
docker compose up -d --remove-orphans

# 5. Wait for PostgreSQL & Run Prisma
echo -e "\n${YELLOW}==> [5/6] Verifying database connectivity & Prisma schemas...${NC}"
PG_USER="${POSTGRES_USER:-postgres}"
PG_DB="${POSTGRES_DB:-ocusphere_optical}"

MAX_RETRIES=30
COUNT=0
echo -n "    Waiting for PostgreSQL container to become ready"
until docker compose exec -T postgres pg_isready -U "${PG_USER}" -d "${PG_DB}" > /dev/null 2>&1 || [ $COUNT -ge $MAX_RETRIES ]; do
    COUNT=$((COUNT+1))
    echo -n "."
    sleep 1
done
echo ""

if [ $COUNT -ge $MAX_RETRIES ]; then
    echo -e "    ${RED}[ERROR] PostgreSQL timed out after ${MAX_RETRIES} seconds.${NC}"
    exit 1
fi
echo -e "    ${GREEN}PostgreSQL is healthy and accepting connections.${NC}"

echo -e "    Generating Prisma Client..."
docker compose exec -T backend npx prisma generate

echo -e "    Applying Prisma migrations..."
docker compose exec -T backend npx prisma migrate deploy || {
    echo -e "    ${YELLOW}[INFO] migrate deploy skipped or pending; trying dev migration fallback...${NC}"
    docker compose exec -T backend npx prisma migrate dev --name auto_deploy || true
}

# 6. Service Health Status & Summary
echo -e "\n${YELLOW}==> [6/6] Docker Compose Service Status:${NC}"
docker compose ps

PORT_FRONTEND="${PORT:-3002}"
PORT_BACKEND="${BACKEND_PORT:-3005}"
PORT_DB="${POSTGRES_PORT:-5434}"

echo -e "\n${GREEN}====================================================================${NC}"
echo -e "${GREEN}  Local Deployment Complete! Services are operational:              ${NC}"
echo -e "${GREEN}====================================================================${NC}"
echo -e "  * Storefront & POS Admin: ${CYAN}http://localhost:${PORT_FRONTEND}${NC}"
echo -e "  * Backend API Health:     ${CYAN}http://localhost:${PORT_BACKEND}/api/v1/health${NC}"
echo -e "  * Swagger API Docs:       ${CYAN}http://localhost:${PORT_BACKEND}/api/docs${NC}"
echo -e "  * PostgreSQL Database:    ${CYAN}localhost:${PORT_DB} (db: ${PG_DB})${NC}"
echo -e "${GREEN}====================================================================${NC}"
